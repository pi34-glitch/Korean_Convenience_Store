@model KoreanStoreMvc.Models.VentaModel
@{
    Layout = null;
    ViewData["Title"] = "Ticket Digital";
    var metodoIcono = Model.Metodo_pago switch
    {
        "Efectivo" => "💵",
        "QR" => "📱",
        "Tarjeta" => "💳",
        _ => "💰"
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Ticket #@Model.Id_venta - BekeenCo</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Courier New', monospace;
            background: #F8FAFC;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .ticket {
            background: #FFFFFF;
            width: 380px;
            border-top: 6px solid #E60000;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }
        .header { text-align: center; margin-bottom: 20px; }
        .header .logo {
            width: 60px; height: 60px; margin: 0 auto 8px;
            background: #E60000; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 32px;
        }
        .header h1 {
            color: #E60000; font-size: 22px;
            letter-spacing: 2px; font-weight: 700;
        }
        .header .subtitulo {
            font-size: 11px; color: #6B7280;
            letter-spacing: 1px; margin-top: 4px;
        }
        .divider {
            border-top: 1px dashed #D1D5DB;
            margin: 12px 0;
        }
        .info {
            font-size: 12px;
            color: #4B5563;
            display: flex;
            justify-content: space-between;
            margin-bottom: 4px;
        }
        .info strong { color: #111827; }
        table { width: 100%; border-collapse: collapse; margin: 12px 0; }
        th {
            text-align: left; font-size: 11px;
            color: #6B7280; padding: 6px 0;
            border-bottom: 1px solid #E5E7EB;
            text-transform: uppercase;
        }
        th.right, td.right { text-align: right; }
        td {
            font-size: 12px;
            padding: 6px 0;
            color: #111827;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            font-size: 20px; font-weight: 700;
            color: #E60000;
            padding: 12px 0;
            border-top: 2px solid #E60000;
            border-bottom: 2px solid #E60000;
            margin: 12px 0;
        }
        .metodo {
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            color: #111827;
            background: #FEF2F2;
            padding: 8px;
            border-radius: 6px;
            margin: 12px 0;
        }
        .pie {
            text-align: center;
            font-size: 11px;
            color: #6B7280;
            margin-top: 16px;
            line-height: 1.6;
        }
        .pie strong { color: #E60000; }
        .acciones {
            display: flex; gap: 8px;
            margin-top: 16px;
            width: 380px;
            position: fixed;
            bottom: 20px;
        }
        .acciones button, .acciones a {
            flex: 1;
            padding: 12px;
            border: none; border-radius: 8px;
            font-size: 14px; font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            font-family: inherit;
        }
        .btn-print { background: #E60000; color: white; }
        .btn-nueva { background: #6B7280; color: white; }
    </style>
</head>
<body>
    <div>
        <div class="ticket">
            <div class="header">
                <div class="logo">🍜</div>
                <h1>BEKEENCO</h1>
                <div class="subtitulo">KOREAN CONVENIENCE STORE</div>
            </div>

            <div class="divider"></div>

            <div class="info">
                <span>Ticket:</span>
                <strong>#@Model.Id_venta.ToString("D6")</strong>
            </div>
            <div class="info">
                <span>Fecha:</span>
                <strong>@Model.Fecha_venta.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
            <div class="info">
                <span>Cajero ID:</span>
                <strong>@Model.Id_user</strong>
            </div>

            <div class="divider"></div>

            <table>
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th class="right">Cant.</th>
                        <th class="right">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@(d.NombreProducto ?? $"Prod #{d.Id_producto}")</td>
                            <td class="right">@d.Cantidad_o_gramos.ToString("0.##")</td>
                            <td class="right">Bs. @d.Subtotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="total-row">
                <span>TOTAL</span>
                <span>Bs. @Model.Total.ToString("F2")</span>
            </div>

            <div class="metodo">
                @metodoIcono Pago: @Model.Metodo_pago
            </div>

            <div class="pie">
                ¡Gracias por su compra!<br />
                <strong>BekeenCo</strong> · Cochabamba, Bolivia<br />
                Conserve su ticket para cualquier reclamo.
            </div>
        </div>

        <div class="acciones">
            <button class="btn-print" onclick="window.print()">🖨️ Imprimir</button>
            <a class="btn-nueva" href="/Caja/Index">🧾 Nueva venta</a>
        </div>
    </div>
</body>
</html>