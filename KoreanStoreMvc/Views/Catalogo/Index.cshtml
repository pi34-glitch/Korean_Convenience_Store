@using KoreanStoreMvc.Helpers
@model List<KoreanStoreMvc.Models.ProductoModel>

@{
    ViewData["Title"] = "Catálogo Digital";
}

<div class="catalogo-container">

    <!-- ENCABEZADO -->
    <div class="catalogo-header text-center mb-4">
        <h1 class="catalogo-titulo">Catálogo Digital</h1>
        <p class="catalogo-subtitulo">Explora nuestros productos y simula tu consumo.</p>
    </div>

    <!-- CATEGORÍAS -->
    <div class="categorias">
        <button class="categoria-btn activo" onclick="filtrarCategoria('todos', this)">
            <i class="bi bi-grid-fill me-1"></i> Todos
        </button>
        <button class="categoria-btn" onclick="filtrarCategoria('caldos', this)">
            <i class="bi bi-cup-hot me-1"></i> Instantáneos
        </button>
        <button class="categoria-btn" onclick="filtrarCategoria('fideos', this)">
            <i class="bi bi-egg-fried me-1"></i> Fideos
        </button>
        <button class="categoria-btn" onclick="filtrarCategoria('bebidas', this)">
            <i class="bi bi-cup-straw me-1"></i> Bebidas
        </button>
        <button class="categoria-btn" onclick="filtrarCategoria('snacks', this)">
            <i class="bi bi-bag-heart me-1"></i> Snacks
        </button>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="catalogo-contenido">

        <!-- PRODUCTOS -->
        <div class="productos">
            @foreach (var producto in Model)
            {
                var nombreLower = producto.Nombre.ToLower();
                string categoria = "otros";

                if (nombreLower.Contains("ramen") || nombreLower.Contains("fideo") || 
                    nombreLower.Contains("noodle") || nombreLower.Contains("udon"))
                {
                    categoria = "fideos";
                }
                else if (nombreLower.Contains("caldo") || nombreLower.Contains("sopa") || nombreLower.Contains("sop"))
                {
                    categoria = "caldos";
                }
                else if (nombreLower.Contains("coca") || nombreLower.Contains("bebida") || 
                         nombreLower.Contains("agua") || nombreLower.Contains("soju") || 
                         nombreLower.Contains("té") || nombreLower.Contains("tea") || 
                         nombreLower.Contains("milkis"))
                {
                    categoria = "bebidas";
                }
                else if (nombreLower.Contains("snack") || nombreLower.Contains("galleta") || 
                         nombreLower.Contains("papas") || nombreLower.Contains("chips") ||
                         nombreLower.Contains("pocky") || nombreLower.Contains("pepero") ||
                         nombreLower.Contains("choco pie"))
                {
                    categoria = "snacks";
                }

                var imagenUrl = ImagenHelper.ObtenerImagen(producto.Nombre);

                <div class="producto-card" data-categoria="@categoria">
                    
                    <!-- Imagen -->
                    <div class="producto-imagen">
                        <img src="@imagenUrl" alt="@producto.Nombre" loading="lazy" />
                        @if (producto.Stock_actual <= 0)
                        {
                            <div class="badge-agotado">AGOTADO</div>
                        }
                        <span class="badge-tipo">@producto.Tipo_venta</span>
                    </div>

                    <div class="producto-info">
                        <h3 class="producto-nombre">@producto.Nombre</h3>
                        
                        <p class="producto-proveedor">
                            <i class="bi bi-shop me-1"></i>
                            @(producto.NombreProveedor ?? "Producto")
                        </p>

                        <div class="producto-precio-box">
                            <span class="precio-label">Precio</span>
                            <span class="producto-precio">
                                Bs. @producto.Precio_unitario.ToString("0.00")
                            </span>
                            @if (producto.Tipo_venta == "PesoGramos" || producto.Tipo_venta == "Kilo")
                            {
                                <span class="precio-unidad">/ kg</span>
                            }
                        </div>

                        @if (producto.Stock_actual > 0)
                        {
                            <p class="stock disponible">
                                <i class="bi bi-check-circle-fill me-1"></i> Disponible
                            </p>

                            <div class="simulacion">
                                <label>Cantidad</label>
                                <div class="cantidad-control">
                                    <button type="button" onclick="cambiarCantidad(@producto.Id_producto, -1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input type="number" 
                                           id="cantidad-@producto.Id_producto" 
                                           value="1" 
                                           min="1"
                                           onchange="calcularProducto(@producto.Id_producto, @producto.Precio_unitario.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                    <button type="button" onclick="cambiarCantidad(@producto.Id_producto, 1)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <p class="subtotal">
                                    Subtotal:
                                    <strong id="subtotal-@producto.Id_producto">
                                        Bs. @producto.Precio_unitario.ToString("0.00")
                                    </strong>
                                </p>

                                <button type="button" class="btn-agregar"
                                        onclick="agregarAlConsumo(
                                            @producto.Id_producto,
                                            '@producto.Nombre.Replace("'", "\\'")',
                                            @producto.Precio_unitario.ToString(System.Globalization.CultureInfo.InvariantCulture)
                                        )">
                                    <i class="bi bi-cart-plus me-1"></i> Agregar al consumo
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="stock agotado">
                                <i class="bi bi-x-circle-fill me-1"></i> Agotado
                            </p>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- RESUMEN -->
        <div class="resumen">
            <div class="resumen-header">
                <h2><i class="bi bi-basket me-2"></i>Mi consumo</h2>
            </div>

            <div id="lista-consumo">
                <p class="sin-productos">
                    <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
                    Todavía no has agregado productos.
                </p>
            </div>

            <div class="total">
                <span>Total estimado</span>
                <strong id="total-consumo">Bs. 0.00</strong>
            </div>

            <div class="acciones-resumen">
                <button type="button" class="btn-limpiar" onclick="limpiarConsumo()">
                    <i class="bi bi-trash me-1"></i> Limpiar
                </button>
                <button type="button" class="btn-imprimir" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Imprimir Ticket
                </button>
            </div>
        </div>

    </div>
</div>

<style>
    /* ===== CATÁLOGO PREMIUM ===== */
    .catalogo-container {
        width: 95%;
        max-width: 1400px;
        margin: 35px auto;
        font-family: 'Poppins', sans-serif;
    }

    .catalogo-titulo {
        color: #E60000;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .catalogo-subtitulo {
        color: #6B7280;
        font-size: 1.1rem;
    }

    /* ===== CATEGORÍAS ===== */
    .categorias {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 35px;
    }

    .categoria-btn {
        border: 2px solid #E60000;
        background-color: white;
        color: #E60000;
        padding: 10px 24px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .categoria-btn:hover,
    .categoria-btn.activo {
        background-color: #E60000;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(230, 0, 0, 0.25);
    }

    /* ===== LAYOUT ===== */
    .catalogo-contenido {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 30px;
        align-items: start;
    }

    /* ===== PRODUCTOS ===== */
    .productos {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 22px;
    }

    .producto-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .producto-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    /* Imagen */
    .producto-imagen {
        height: 180px;
        position: relative;
        overflow: hidden;
        background: #F9FAFB;
    }

    .producto-imagen img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .producto-card:hover .producto-imagen img {
        transform: scale(1.08);
    }

    .badge-tipo {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(230, 0, 0, 0.9);
        color: white;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        backdrop-filter: blur(4px);
    }

    .badge-agotado {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(17, 24, 39, 0.85);
        color: white;
        font-size: 0.9rem;
        font-weight: 700;
        padding: 8px 20px;
        border-radius: 8px;
        letter-spacing: 1px;
    }

    /* Info */
    .producto-info {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .producto-nombre {
        font-size: 1.05rem;
        font-weight: 600;
        color: #111827;
        margin: 0 0 8px 0;
        line-height: 1.3;
    }

    .producto-proveedor {
        color: #9CA3AF;
        font-size: 0.8rem;
        margin-bottom: 12px;
    }

    .producto-precio-box {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-bottom: 10px;
        padding: 8px 12px;
        background: #FEF2F2;
        border-radius: 10px;
        border-left: 3px solid #E60000;
    }

    .precio-label {
        font-size: 0.75rem;
        color: #6B7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .producto-precio {
        color: #E60000;
        font-size: 1.4rem;
        font-weight: 700;
        margin-left: auto;
    }

    .precio-unidad {
        font-size: 0.8rem;
        color: #6B7280;
    }

    /* Stock */
    .stock {
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .disponible { color: #059669; }
    .agotado { color: #DC2626; }

    /* Simulación */
    .simulacion {
        border-top: 1px solid #F3F4F6;
        margin-top: auto;
        padding-top: 14px;
    }

    .simulacion label {
        display: block;
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 8px;
        color: #374151;
    }

    .cantidad-control {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .cantidad-control button {
        width: 36px;
        height: 36px;
        border: none;
        background-color: #E60000;
        color: white;
        font-size: 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cantidad-control button:hover {
        background-color: #B80000;
    }

    .cantidad-control input {
        flex: 1;
        height: 36px;
        text-align: center;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-weight: 600;
        color: #111827;
    }

    .cantidad-control input:focus {
        outline: none;
        border-color: #E60000;
        box-shadow: 0 0 0 3px rgba(230, 0, 0, 0.1);
    }

    .subtotal {
        margin-top: 12px;
        color: #6B7280;
        font-size: 0.9rem;
    }

    .subtotal strong {
        color: #E60000;
        font-size: 1.05rem;
    }

    .btn-agregar {
        width: 100%;
        margin-top: 12px;
        padding: 11px;
        background-color: #E60000;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-agregar:hover {
        background-color: #B80000;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(230, 0, 0, 0.3);
    }

    /* ===== RESUMEN ===== */
    .resumen {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        position: sticky;
        top: 90px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .resumen-header {
        background: linear-gradient(135deg, #E60000, #B80000);
        padding: 20px;
    }

    .resumen-header h2 {
        color: white;
        margin: 0;
        font-size: 1.2rem;
        font-weight: 600;
    }

    #lista-consumo {
        padding: 16px;
        max-height: 380px;
        overflow-y: auto;
    }

    .sin-productos {
        text-align: center;
        color: #9CA3AF;
        padding: 20px 0;
        font-size: 0.9rem;
    }

    .consumo-item {
        border-bottom: 1px solid #F3F4F6;
        padding: 12px 0;
        font-size: 0.9rem;
    }

    .consumo-item:last-child { border-bottom: none; }

    .consumo-item strong { color: #111827; }
    .consumo-item small { color: #9CA3AF; }

    .total {
        border-top: 2px solid #E60000;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #FEF2F2;
    }

    .total span {
        font-weight: 600;
        color: #374151;
    }

    .total strong {
        color: #E60000;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .acciones-resumen {
        display: flex;
        gap: 10px;
        padding: 0 16px 16px;
    }

    .btn-limpiar, .btn-imprimir {
        flex: 1;
        padding: 10px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        border: 2px solid #E60000;
    }

    .btn-limpiar {
        background: white;
        color: #E60000;
    }

    .btn-limpiar:hover {
        background: #FEF2F2;
    }

    .btn-imprimir {
        background: #E60000;
        color: white;
    }

    .btn-imprimir:hover {
        background: #B80000;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .catalogo-contenido {
            grid-template-columns: 1fr;
        }
        .resumen {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .catalogo-titulo { font-size: 1.8rem; }
        .productos { grid-template-columns: 1fr; }
        .categoria-btn { padding: 8px 16px; font-size: 0.85rem; }
    }

    /* ===== IMPRESIÓN ===== */
    @@media print {
        header, footer, .categorias, .productos, .catalogo-header { display: none !important; }
        .resumen { position: static; box-shadow: none; border: 1px solid #ccc; }
        .acciones-resumen { display: none !important; }
    }
</style>

<script>
    // ==========================================
    // TU LÓGICA JS INTACTA
    // ==========================================
    let consumo = [];

    function cambiarCantidad(id, cambio) {
        const input = document.getElementById("cantidad-" + id);
        let cantidad = parseInt(input.value) || 1;
        cantidad += cambio;
        if (cantidad < 1) cantidad = 1;
        input.value = cantidad;
        calcularProductoDesdeVista(id);
    }

    function calcularProducto(id, precio) {
        const input = document.getElementById("cantidad-" + id);
        let cantidad = parseInt(input.value) || 1;
        if (cantidad < 1) { cantidad = 1; input.value = 1; }
        const subtotal = cantidad * precio;
        document.getElementById("subtotal-" + id).innerText = "Bs. " + subtotal.toFixed(2);
    }

    function calcularProductoDesdeVista(id) {
        const input = document.getElementById("cantidad-" + id);
        const card = input.closest(".producto-card");
        const precioTexto = card.querySelector(".producto-precio").innerText.replace("Bs.", "").trim();
        const precio = parseFloat(precioTexto);
        calcularProducto(id, precio);
    }

    function agregarAlConsumo(id, nombre, precio) {
        const input = document.getElementById("cantidad-" + id);
        const cantidad = parseInt(input.value) || 1;
        const subtotal = cantidad * precio;
        const existente = consumo.find(p => p.id === id);
        if (existente) {
            existente.cantidad += cantidad;
            existente.subtotal = existente.cantidad * existente.precio;
        } else {
            consumo.push({ id, nombre, precio, cantidad, subtotal });
        }
        mostrarConsumo();
    }

    function mostrarConsumo() {
        const lista = document.getElementById("lista-consumo");
        lista.innerHTML = "";
        let total = 0;
        if (consumo.length === 0) {
            lista.innerHTML = '<p class="sin-productos"><i class="bi bi-cart-x fs-1 d-block mb-2"></i>Todavía no has agregado productos.</p>';
        }
        consumo.forEach(producto => {
            total += producto.subtotal;
            lista.innerHTML += `
                <div class="consumo-item">
                    <strong>${producto.nombre}</strong><br>
                    <small>${producto.cantidad} × Bs. ${producto.precio.toFixed(2)}</small><br>
                    <strong>Bs. ${producto.subtotal.toFixed(2)}</strong>
                </div>`;
        });
        document.getElementById("total-consumo").innerText = "Bs. " + total.toFixed(2);
    }

    function limpiarConsumo() {
        consumo = [];
        mostrarConsumo();
    }

    function filtrarCategoria(categoria, boton) {
        document.querySelectorAll(".producto-card").forEach(producto => {
            producto.style.display = (categoria === "todos" || producto.dataset.categoria === categoria) ? "" : "none";
        });
        document.querySelectorAll(".categoria-btn").forEach(btn => btn.classList.remove("activo"));
        boton.classList.add("activo");
    }
</script>