@{
    ViewData["Title"] = "Acceso Denegado";
}

<div style="
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    font-family: 'Segoe UI', sans-serif;">
    <div style="
        background: #FFFFFF;
        border: 2px solid #E60000;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        max-width: 420px;
        box-shadow: 0 8px 24px rgba(230,0,0,0.15);">
        <div style="font-size: 60px; margin-bottom: 16px;">🚫</div>
        <h1 style="color: #E60000; font-size: 22px; margin-bottom: 12px;">
            Acceso Denegado
        </h1>
        <p style="color: #4B5563; font-size: 14px; margin-bottom: 24px;">
            No tienes los permisos necesarios para acceder a esta sección.
            Esta área está reservada para usuarios con rol <strong>CajeroVendedor</strong>.
        </p>
        <a href="/Home/Index" style="
            display: inline-block;
            background: #E60000;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;">
            Volver al inicio
        </a>
    </div>
</div>