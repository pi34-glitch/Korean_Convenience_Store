@model KoreanStoreMvc.Models.ReseñaModel
@{
    ViewData["Title"] = "Editar Reseña";
    var producto = ViewBag.Producto as KoreanStoreMvc.Models.ProductoModel;
}

<div class="form-resena">
    <h1><i class="bi bi-pencil-square me-2"></i>Editar Reseña</h1>
    <p class="subtitle">Modifica tu calificación o comentario.</p>

    @if (ViewBag.Error != null)
    {
        <div class="error-api">@ViewBag.Error</div>
    }

    @if (producto != null)
    {
        <div class="producto-info">
            <h3>@producto.Nombre</h3>
            <p>Precio: Bs. @producto.Precio_unitario.ToString("F2")</p>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Id_producto" />
        <input type="hidden" asp-for="Id_user" />

        <div class="form-group">
            <label>Calificación *</label>
            <div class="estrellas">
                <input type="radio" asp-for="Calificacion" value="5" id="e5" />
                <label for="e5">★</label>
                <input type="radio" asp-for="Calificacion" value="4" id="e4" />
                <label for="e4">★</label>
                <input type="radio" asp-for="Calificacion" value="3" id="e3" />
                <label for="e3">★</label>
                <input type="radio" asp-for="Calificacion" value="2" id="e2" />
                <label for="e2">★</label>
                <input type="radio" asp-for="Calificacion" value="1" id="e1" />
                <label for="e1">★</label>
            </div>
            <span asp-validation-for="Calificacion" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Comentario">Comentario</label>
            <textarea asp-for="Comentario" placeholder="Cuéntanos qué te pareció..."></textarea>
            <span asp-validation-for="Comentario" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-submit">
            <i class="bi bi-check-circle me-1"></i> Guardar Cambios
        </button>
        <a asp-action="PorProducto" asp-route-id="@Model.Id_producto" class="btn-cancelar">
            Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}