@model List<KoreanStoreMvc.Models.ReseñaModel>
@{
    ViewData["Title"] = "Reseñas del Producto";
    var producto = ViewBag.Producto as KoreanStoreMvc.Models.ProductoModel;
    var productoId = ViewBag.ProductoId as int?;
}

<div class="container-resenias">

    @if (TempData["Exito"] != null)
    {
        <div class="alert-exito">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="header-resenas">
        <div>
            <a asp-action="Index" class="btn-volver">
                <i class="bi bi-arrow-left me-1"></i> Volver a productos
            </a>
            <h1>Reseñas de Comensales</h1>
            @if (producto != null)
            {
                <p class="subtitle">Mostrando reseñas de: <strong>@producto.Nombre</strong></p>
            }
        </div>

        @if (productoId.HasValue)
        {
            <a asp-action="Create" asp-route-productoId="@productoId" class="btn-nueva">
                <i class="bi bi-plus-circle me-1"></i> Escribir reseña
            </a>
        }
    </div>

    <div class="resenas-lista">
        @if (Model == null || !Model.Any())
        {
            <div class="sin-resenas">
                <i class="bi bi-chat-square-text fs-1 d-block mb-3"></i>
                <h3>Aún no hay reseñas</h3>
                <p>Sé el primero en compartir tu experiencia con este producto.</p>
            </div>
        }
        else
        {
            @foreach (var r in Model)
            {
                <div class="card-resena">
                    <div class="card-header">
                        <span class="usuario"><i class="bi bi-person-circle me-1"></i>@(r.NombreUsuario ?? "Anónimo")</span>
                        <span class="fecha"><i class="bi bi-calendar me-1"></i>@r.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="estrellas-vista">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="@(i <= r.Calificacion ? "activa" : "vacia")">★</span>
                        }
                        <span class="calificacion-texto">(@r.Calificacion/5)</span>
                    </div>

                    <p class="comentario">"@r.Comentario"</p>

                    <div class="acciones-resena">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn-editar">
                            <i class="bi bi-pencil me-1"></i> Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@r.Id" class="btn-eliminar">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    :root {
        --rojo-bekeenco: #E60000;
        --blanco: #FFFFFF;
        --gris-fondo: #F9FAFB;
        --gris-texto: #4B5563;
        --amarillo-estrella: #F59E0B;
    }

    .container-resenias {
        max-width: 900px;
        margin: 30px auto;
        padding: 0 20px;
        font-family: 'Poppins', sans-serif;
    }

    .header-resenas {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .header-resenas h1 { color: var(--rojo-bekeenco); margin: 0.5rem 0 0; font-size: 1.8rem; }
    .header-resenas .subtitle { color: var(--gris-texto); margin: 0.3rem 0 0; }

    .btn-volver {
        color: var(--gris-texto);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
    }
    .btn-volver:hover { color: var(--rojo-bekeenco); }

    .btn-nueva {
        background: var(--rojo-bekeenco);
        color: white;
        padding: 0.7rem 1.5rem;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.2s;
    }
    .btn-nueva:hover { background: #B80000; color: white; transform: translateY(-1px); }

    .card-resena {
        background: var(--blanco);
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        border-left: 4px solid var(--rojo-bekeenco);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.7rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .usuario { color: var(--gris-texto); font-weight: 600; font-size: 0.95rem; }
    .fecha { color: #9CA3AF; font-size: 0.85rem; }

    .estrellas-vista { color: var(--amarillo-estrella); font-size: 1.3rem; letter-spacing: 2px; }
    .estrellas-vista .vacia { color: #D1D5DB; }
    .calificacion-texto { color: #6B7280; font-size: 0.85rem; margin-left: 0.5rem; letter-spacing: 0; }

    .comentario {
        color: #111827;
        font-size: 0.95rem;
        line-height: 1.5;
        margin: 0 0 1rem 0;
        font-style: italic;
    }

    .acciones-resena {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn-editar, .btn-eliminar {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-editar {
        color: var(--rojo-bekeenco);
        border: 2px solid var(--rojo-bekeenco);
        background: white;
    }
    .btn-editar:hover { background: var(--rojo-bekeenco); color: white; }

    .btn-eliminar {
        color: #6B7280;
        border: 2px solid #E5E7EB;
        background: white;
    }
    .btn-eliminar:hover { background: #FEE2E2; color: #B91C1C; border-color: #B91C1C; }

    .sin-resenas {
        text-align: center;
        padding: 3rem;
        color: var(--gris-texto);
        background: var(--blanco);
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .sin-resenas h3 { color: var(--rojo-bekeenco); }

    .alert-exito, .alert-error {
        padding: 1rem 1.5rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }

    .alert-exito {
        background: #D1FAE5;
        color: #065F46;
        border-left: 4px solid #065F46;
    }

    .alert-error {
        background: #FEE2E2;
        color: #B91C1C;
        border-left: 4px solid #B91C1C;
    }
</style>