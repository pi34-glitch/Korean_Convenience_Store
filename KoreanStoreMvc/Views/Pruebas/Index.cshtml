@model List<KoreanStoreMvc.Controllers.CalculoProducto>

@{
    ViewData["Title"] = "Cálculo por Unidad";
    decimal totalGeneral = Model.Sum(p => p.Subtotal);
}

<style>
    body { background-color: #F9FAFB; font-family: 'Segoe UI', sans-serif; padding: 2rem; }
    .header { background-color: #FFFFFF; border-left: 6px solid #E60000; border-radius: 12px; padding: 1.5rem 2rem; margin-bottom: 2rem; }
    .header h1 { color: #E60000; margin: 0 0 0.5rem 0; }
    .ecuacion { background-color: #FFFFFF; border: 2px dashed #E60000; border-radius: 12px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; text-align: center; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; background-color: #FFFFFF; border-radius: 12px; overflow: hidden; }
    thead { background-color: #E60000; color: #FFFFFF; }
    th, td { padding: 1rem; text-align: left; border-bottom: 1px solid #E5E7EB; }
    tfoot td { background-color: #FEF2F2; font-weight: 700; font-size: 1.1rem; color: #E60000; border-top: 3px solid #E60000; }
    .col-monto { font-family: 'Courier New', monospace; text-align: right; }
    .nota { margin-top: 1.5rem; padding: 1rem; background-color: #FEF3C7; border-left: 4px solid #F59E0B; border-radius: 8px; font-size: 0.9rem; }
</style>

<div class="header">
    <h1>🧮 Cálculo por Precio Unitario — HU-04</h1>
    <p>Verificación del cálculo de subtotales según precio unitario y cantidad seleccionada</p>
</div>

<div class="ecuacion">
    <strong>Subtotal =</strong> <span style="color: #E60000;">Precio Unitario</span> × <span style="color: #E60000;">Cantidad</span>
</div>

<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Producto</th>
            <th>Precio Unitario</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @{ var i = 1; }
        @foreach (var item in Model)
        {
            <tr>
                <td>@i</td>
                <td><strong>@item.Producto</strong></td>
                <td class="col-monto">Bs. @item.PrecioUnitario.ToString("F2")</td>
                <td class="col-monto">@item.Cantidad</td>
                <td class="col-monto"><strong>Bs. @item.Subtotal.ToString("F2")</strong></td>
            </tr>
            i++;
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="4" style="text-align: right;">TOTAL:</td>
            <td class="col-monto">Bs. @totalGeneral.ToString("F2")</td>
        </tr>
    </tfoot>
</table>

<div class="nota">
    <strong>📌 Nota:</strong> Cada subtotal se calcula multiplicando el precio unitario por la cantidad. Este mismo cálculo se ejecuta en tiempo real en /Caja/Index.
</div>