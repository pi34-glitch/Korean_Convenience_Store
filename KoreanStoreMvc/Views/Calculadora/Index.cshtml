@model KoreanStoreMvc.Models.CarritoModel

@{
    ViewData["Title"] = "Calculadora por Gramaje";
}

<div class="calculadora-container">

    <div class="encabezado text-center mb-4">
        <h1 class="calculadora-titulo">Calculadora por Gramaje</h1>
        <p class="calculadora-subtitulo">Calcula el precio de un producto según su peso y genera el comprobante.</p>
    </div>

    <div class="calculadora-card">
        <div class="card-header-calc">
            <h2><i class="bi bi-calculator me-2"></i>Datos del producto</h2>
        </div>

        <form asp-action="Index" method="post" class="p-4">
            <div class="campo mb-3">
                <label asp-for="Id_producto" class="form-label fw-semibold">
                    <i class="bi bi-box-seam me-1"></i> Producto
                </label>
                <select asp-for="Id_producto" class="form-select form-control-bekeen">
                    <option value="0">-- Selecciona un producto --</option>
                    @foreach (var producto in ViewBag.Productos)
                    {
                        <option value="@producto.Id_producto">
                            @producto.Nombre - Bs. @producto.Precio_unitario.ToString("0.00") / g
                        </option>
                    }
                </select>
            </div>

            <div class="campo mb-3">
                <label asp-for="CantidadGramo" class="form-label fw-semibold">
                    <i class="bi bi-speedometer2 me-1"></i> Cantidad en gramos
                </label>
                <input asp-for="CantidadGramo"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="form-control form-control-bekeen"
                       placeholder="Ejemplo: 500" />
                <span asp-validation-for="CantidadGramo" class="mensaje-error"></span>
            </div>

            <button type="submit" class="btn-calcular">
                <i class="bi bi-calculator me-2"></i> Calcular precio
            </button>
        </form>

        @if (Model.Subtotal > 0)
        {
            <div class="resultado" id="area-comprobante">
                <p class="resultado-titulo">Precio total</p>
                <p class="resultado-producto">@Model.NombreProducto</p>
                <p class="resultado-precio">Bs. @Model.Subtotal.ToString("0.00")</p>
                <p class="resultado-detalle">@Model.CantidadGramo gramos</p>
            </div>

            <div class="acciones-comprobante">
                <button type="button" class="btn-imprimir" onclick="imprimirComprobante()">
                    <i class="bi bi-printer me-1"></i> Imprimir Comprobante
                </button>
                <a href="/Calculadora/Index" class="btn-nuevo">
                    <i class="bi bi-arrow-clockwise me-1"></i> Nuevo Cálculo
                </a>
            </div>
        }
    </div>

    <!-- Botón para volver a Caja -->
    <div class="text-center mt-4">
        <a href="/Caja/Index" class="btn-volver-caja">
            <i class="bi bi-arrow-left me-1"></i> Volver a Caja
        </a>
    </div>
</div>

<style>
    .calculadora-container {
        width: 90%;
        max-width: 850px;
        margin: 40px auto;
        font-family: 'Poppins', sans-serif;
    }

    .calculadora-titulo {
        color: #E60000;
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .calculadora-subtitulo {
        color: #6B7280;
        font-size: 1rem;
    }

    .calculadora-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .card-header-calc {
        background: linear-gradient(135deg, #E60000, #B80000);
        padding: 20px 30px;
    }

    .card-header-calc h2 {
        color: white;
        margin: 0;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .form-control-bekeen {
        border: 2px solid #E5E7EB;
        border-radius: 10px;
        padding: 12px;
        font-size: 1rem;
        transition: border 0.2s, box-shadow 0.2s;
    }

    .form-control-bekeen:focus {
        outline: none;
        border-color: #E60000;
        box-shadow: 0 0 0 3px rgba(230, 0, 0, 0.1);
    }

    .btn-calcular {
        width: 100%;
        padding: 14px;
        background-color: #E60000;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-calcular:hover {
        background-color: #B80000;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(230, 0, 0, 0.3);
    }

    .resultado {
        margin: 0 30px 24px;
        padding: 24px;
        border: 2px dashed #E60000;
        border-radius: 14px;
        text-align: center;
        background-color: #FEF2F2;
    }

    .resultado-titulo {
        color: #E60000;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .resultado-producto {
        color: #111827;
        font-size: 1.05rem;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .resultado-precio {
        color: #E60000;
        font-size: 2.5rem;
        font-weight: 700;
        margin: 8px 0;
    }

    .resultado-detalle {
        color: #6B7280;
        font-size: 0.95rem;
    }

    .mensaje-error {
        color: #DC2626;
        font-size: 0.85rem;
        display: block;
        margin-top: 4px;
    }

    .acciones-comprobante {
        display: flex;
        gap: 12px;
        padding: 0 30px 30px;
    }

    .btn-imprimir, .btn-nuevo {
        flex: 1;
        padding: 12px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
    }

    .btn-imprimir {
        background-color: #E60000;
        color: white;
    }

    .btn-imprimir:hover {
        background-color: #B80000;
        color: white;
    }

    .btn-nuevo {
        background-color: white;
        color: #E60000;
        border: 2px solid #E60000;
    }

    .btn-nuevo:hover {
        background-color: #FEF2F2;
        color: #B80000;
    }

    .btn-volver-caja {
        display: inline-block;
        padding: 10px 24px;
        background-color: white;
        color: #6B7280;
        border: 2px solid #E5E7EB;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-volver-caja:hover {
        border-color: #E60000;
        color: #E60000;
    }

    @@media print {
        .btn-volver-caja, .acciones-comprobante, form, .calculadora-subtitulo { display: none !important; }
        .calculadora-card { box-shadow: none; border: 1px solid #ccc; }
        .resultado { border: 2px solid #000; }
    }
</style>

@section Scripts {
    <script>
        function imprimirComprobante() {
            window.print();
        }
    </script>
}