@{
    ViewData["Title"] = "Panel de Cajero";
    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? "Cajero";
    var rolUsuario = Context.Session.GetString("Rol") ?? "Cajero";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-1 text-dark">Módulo de Caja</h1>
            <p class="text-muted mb-0">Gestión de ventas y cobros presenciales — BekeenCo</p>
        </div>
        <div>
            <span class="badge bg-success fs-6 px-3 py-2">
                Rol actual: @rolUsuario
            </span>
        </div>
    </div>

    <div class="card bg-light border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h4 class="card-title text-primary fw-bold">¡Bienvenido, @nombreUsuario!</h4>
            <p class="card-text text-secondary mb-0">
                Acceso validado exitosamente. La directiva <code>[RolRequerido("Cajero", "Administrador")]</code> ha verificado tus permisos de sesión activos.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-primary border-opacity-25 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-center align-items-center py-4">
                    <div class="fs-1 mb-2">🛒</div>
                    <h5 class="card-title">Nueva Venta</h5>
                    <p class="card-text text-muted small">Registrar artículos por unidad para cobro inmediato.</p>
                    <button class="btn btn-primary w-100 disabled">Iniciar Cobro</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-warning border-opacity-25 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-center align-items-center py-4">
                    <div class="fs-1 mb-2">⚖️</div>
                    <h5 class="card-title">Venta por Gramos</h5>
                    <p class="card-text text-muted small">Pesar y calcular precio para productos a granel.</p>
                    <button class="btn btn-warning w-100 text-dark disabled">Pesar Producto</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-secondary border-opacity-25 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-center align-items-center py-4">
                    <div class="fs-1 mb-2">📋</div>
                    <h5 class="card-title">Turno Actual</h5>
                    <p class="card-text text-muted small">Ver el resumen de arqueo y transacciones del turno.</p>
                    <button class="btn btn-outline-secondary w-100 disabled">Ver Resumen</button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
            ← Volver al Inicio
        </a>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger">
            Cerrar Sesión
        </a>
    </div>
</div>