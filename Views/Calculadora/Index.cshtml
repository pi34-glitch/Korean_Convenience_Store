@model Korean_Convenience_Store.Models.Carrito

@{
    ViewData["Title"] = "Calculadora por Gramaje";
}

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1 class="titulo">Calculadora por Gramaje</h1>

        <p class="text-muted">
            Calcula el precio de un producto según la cantidad de gramos.
        </p>
    </div>


    <div class="calculadora">

        <h2>Datos del producto</h2>


        <form asp-action="Index" method="post">

            <div class="mb-3">

                <label asp-for="IdProducto" class="form-label">
                    Producto
                </label>

                <select asp-for="IdProducto"
                        class="form-select">

                    <option value="">
                        Selecciona un producto
                    </option>

                    @foreach (var producto in ViewBag.Productos)
                    {
                        <option value="@producto.Id">
                            @producto.Nombre -
                            Bs. @producto.Precio por gramo
                        </option>
                    }

                </select>

                <span asp-validation-for="IdProducto"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="CantidadGramo"
                       class="form-label">
                    Cantidad en gramos
                </label>

                <input asp-for="CantidadGramo"
                       type="number"
                       class="form-control"
                       placeholder="Ejemplo: 500"
                       min="0"
                       step="0.01" />

                <span asp-validation-for="CantidadGramo"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="btn-calcular">
                Calcular precio
            </button>

        </form>


        @if (Model.Subtotal > 0)
        {
            <div class="resultado">

                <h3>Precio total</h3>

                <p>
                    Bs. @Model.Subtotal.ToString("0.00")
                </p>

            </div>
        }

    </div>

</div>


<style>

    body {
        background-color: #ffffff;
    }

    .container {
        max-width: 900px;
    }

    .titulo {
        color: #c62828;
        font-weight: bold;
    }

    .calculadora {
        background-color: white;
        border: 1px solid #dddddd;
        border-radius: 15px;
        padding: 35px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .calculadora h2 {
        background-color: #c62828;
        color: white;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: bold;
    }

    .form-control,
    .form-select {
        padding: 12px;
        border: 1px solid #cccccc;
        border-radius: 8px;
    }

    .btn-calcular {
        width: 100%;
        padding: 14px;
        background-color: #c62828;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn-calcular:hover {
        background-color: #a61f1f;
    }

    .resultado {
        margin-top: 30px;
        padding: 25px;
        border: 2px solid #c62828;
        border-radius: 10px;
        text-align: center;
    }

    .resultado h3 {
        color: #c62828;
    }

    .resultado p {
        font-size: 32px;
        font-weight: bold;
        color: #c62828;
        margin: 0;
    }

</style>